# The Stripe fake's settings for a storm: the defaults in Holdfast's load/stack.sh, written out.
# Export these before starting the stack (README). The generator records this file in the
# manifest as *declared* settings: the fake doesn't report what it is actually running with.
FAKE_LATENCY_MS=150-500
FAKE_DECLINE_RATE=0.03
FAKE_LOST_RESPONSE_RATE=0.03
FAKE_SERVER_ERROR_EVERY=25
FAKE_CANCEL_FAULT_RATE=0.1
